# =============================================================================
# EduRAG Merdeka — Environment Variables Template
# PERINGATAN KEAMANAN:
# File ini HANYA contoh/template. JANGAN PERNAH memasukkan API key asli ke sini!
# Untuk penggunaan lokal, salin file ini menjadi .env (sudah dilindungi .gitignore).
# Untuk Streamlit Cloud, masukkan nilai ke menu: App Settings > Secrets.
# =============================================================================

# LLM & Embedding Services
COHERE_API_KEY=your_cohere_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database (Qdrant Cloud)
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Relational Database (MySQL / Aiven)
MYSQL_HOST=your_aiven_mysql_host
MYSQL_PORT=3306
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_mysql_password
MYSQL_DATABASE=defaultdb

# Security & App Config
ENVIRONMENT=production
GUARDRAIL_THRESHOLD=0.70
